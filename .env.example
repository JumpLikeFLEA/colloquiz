# Environment template — copy to .env.local and fill in. The one template in the
# repo (owner, 2026-11-14, MIG-001): .env.local.example is retired.
#
# PLACEHOLDERS ONLY. Never put a real key here: this file is tracked. Real values
# belong in .env.local, which is gitignored. Which names are production,
# local-only or quiz-only: docs/ops/inventory.md, "Environment variable names".

# Supabase — get these from your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only. Personal access token for the Supabase CLI and Management API
# (supabase.com/dashboard/account/tokens). Never set on Vercel.
SUPABASE_ACCESS_TOKEN=

# Anthropic — voice analysis, course import and account deletion's file cleanup.
ANTHROPIC_API_KEY=
# Quiz question generator + critic only (quiz-only).
ANTHROPIC_MODEL_GENERATOR=
ANTHROPIC_MODEL_CRITIC=

# AI voice feedback (docs/decisions/0156, 0187). Server-side only.
# VOICE_ANALYSIS_MODE: off | paused | on. Unset or anything else is off, so production
# stays off until OPS-026's legal revision is published and OPS-027 turns it on. Under
# paused or off, takes still upload but nothing is sent to a provider.
VOICE_ANALYSIS_MODE=
# Speech-to-text (EU endpoint). Needed when the mode is on.
ASSEMBLYAI_API_KEY=
# The model for the analysis. VOICE_ANALYSIS_MODEL wins; ANTHROPIC_MODEL_VOICE is the older
# name (0182 Decision 9) and is still read. Default: claude-sonnet-5-5.
VOICE_ANALYSIS_MODEL=
ANTHROPIC_MODEL_VOICE=

# Course import from a file (docs/decisions/0203). Server-side only.
# COURSE_IMPORT_MODE: anything but "on" is off. On needs ANTHROPIC_API_KEY.
COURSE_IMPORT_MODE=
# Default: claude-opus-5-5.
COURSE_IMPORT_MODEL=

# Bearer secret Vercel Cron sends to /api/cron/*. Without it those routes refuse everything.
CRON_SECRET=

# Telegram bot (@Alliengll_bot, docs/decisions/0173). Server-side only.
# The bot token from BotFather; without it no reminder or ping is sent.
TELEGRAM_BOT_TOKEN=
# The secret_token given to setWebhook. Unset, the webhook route refuses everything.
TELEGRAM_WEBHOOK_SECRET=

# Discord webhook announcing new in-app feedback (Server Settings → Integrations
# → Webhooks → Copy Webhook URL). OPTIONAL: leave it blank and feedback is still
# stored, just not announced — see lib/feedbackNotify.ts. Server-side only, so
# no NEXT_PUBLIC_ prefix: this URL is a bearer credential and must never reach
# the browser bundle. Removed by OPS-040.
FEEDBACK_DISCORD_WEBHOOK_URL=

# Canonical site origin for OG/canonical URLs. OPTIONAL: defaults to
# https://colloquiz.app (see lib/site.ts). Set to the preview URL on previews.
NEXT_PUBLIC_SITE_URL=

# Minutes of inactivity before an in-progress quiz session is expired lazily.
# OPTIONAL; defaults to 60 (quiz-only).
QUIZ_SESSION_TIMEOUT_MINUTES=

# Local-only: scripts/bench.ts. A throwaway account that must already exist in the
# target Supabase project. Use a generated password: this account is real and can
# sign in to production.
BENCH_EMAIL=
BENCH_PASSWORD=
BENCH_PROD_URL=
