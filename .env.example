# Supabase — get these from your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — question generator service (Phase 3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_GENERATOR=
ANTHROPIC_MODEL_CRITIC=

# AI voice feedback (docs/decisions/0156, 0187). Server-side only.
# VOICE_ANALYSIS_MODE: off | paused | on. Unset or anything else is off, so production
# stays off until OPS-026's legal revision is published and OPS-027 turns it on. Under
# paused or off, takes still upload but nothing is sent to a provider.
VOICE_ANALYSIS_MODE=
# Speech-to-text (EU endpoint). Needed when the mode is on.
ASSEMBLYAI_API_KEY=
# The model for the analysis. VOICE_ANALYSIS_MODEL wins; ANTHROPIC_MODEL_VOICE is the older
# name (0182 Decision 9) and is still read. Default: claude-sonnet-5-5.
VOICE_ANALYSIS_MODEL=
ANTHROPIC_MODEL_VOICE=
# Bearer secret Vercel Cron sends to /api/cron/*. Without it those routes refuse everything.
CRON_SECRET=

# Discord webhook announcing new in-app feedback (Server Settings → Integrations
# → Webhooks → Copy Webhook URL). OPTIONAL: leave it blank and feedback is still
# stored, just not announced — see lib/feedbackNotify.ts. Server-side only, so
# no NEXT_PUBLIC_ prefix: this URL is a bearer credential and must never reach
# the browser bundle.
FEEDBACK_DISCORD_WEBHOOK_URL=

# Canonical site origin for OG/canonical URLs. OPTIONAL: defaults to
# https://colloquiz.app (see lib/site.ts). Set to the preview URL on previews.
NEXT_PUBLIC_SITE_URL=
